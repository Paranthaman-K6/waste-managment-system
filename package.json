{
  "name": "waste-management",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @wm/web",
    "dev": "npm run dev -w @wm/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "generate:ws": "node scripts/generate-ws.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "playwright": "^1.62.1",
    "typescript": "^5.6.3"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "^1.2.9",
    "@rolldown/binding-linux-x64-musl": "^1.2.9",
    "@rolldown/binding-wasm32-wasi": "^1.2.9"
  }
}
